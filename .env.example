# Copy this file to .env and replace the placeholders.

# --- Database -------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=assistantfy_db
# Inside Docker the host is the "db" service; keep the credentials in sync
# with POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
DATABASE_URL=postgresql+asyncpg://admin:change_me@db:5432/assistantfy_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5434/assistantfy_test

# --- Redis ----------------------------------------------------------------
REDIS_PASSWORD=change_me
# Host is the "redis" service inside Docker; keep it in sync with REDIS_PASSWORD.
REDIS_URL=redis://:change_me@redis:6379

# --- AI -------------------------------------------------------------------
# DeepSeek API key (the agent calls api.deepseek.com).
AI_API_KEY=your_ai_api_key

# --- Meta / WhatsApp Cloud API --------------------------------------------
# These four values must come from the SAME Meta app that owns the phone
# number. Otherwise webhooks fail with 403 and sends fail with code 100.
# App settings -> Basic
META_APP_SECRET=your_meta_app_secret
# WhatsApp -> API Setup. The default token expires in 24h; prefer a System User token.
WHATSAPP_TOKEN=your_whatsapp_token
# WhatsApp -> API Setup
PHONE_NUMBER_ID=your_phone_number_id
# Arbitrary string; paste the same one into Meta's webhook configuration.
VERIFICATION_TOKEN=change_me

# --- Frontend -------------------------------------------------------------
FRONT_END_URL=http://localhost:5173
